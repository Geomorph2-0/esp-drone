# Kubit: ESP32-D0WD-V3 / 38-pin WROOM-32 DevKit diagnostic build.
# See docs/kubit-esp32.md. Flash capacity and wiring await hardware checks.
CONFIG_TARGET_PORTABLE_SAFE=y
CONFIG_TRANSPORT_NATIVE_WIFI=y
CONFIG_ESPNOW_CONTROL=n
CONFIG_ENABLE_LEGACY_APP=n
CONFIG_ENABLE_POSITION_HOLD_MODE=n
CONFIG_ENABLE_COMMAND_MODE_SET=n
CONFIG_MOTORS_STARTUP_TEST=n
CONFIG_BUZZER_ON=n

# Classic dual-core ESP32; no external PSRAM requirement.
CONFIG_FREERTOS_UNICORE=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=n

# Conservative flash configuration, not a measurement of board capacity.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=n
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=n
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# UART0 console through the DevKit's USB-to-UART bridge.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
