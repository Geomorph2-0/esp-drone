# Append after sdkconfig.defaults and sdkconfig.defaults.esp32 in a fresh build.
CONFIG_IDF_TARGET="esp32"
CONFIG_TARGET_PORTABLE_SAFE=y
CONFIG_KUBIT_IMU_BENCH=y
CONFIG_KUBIT_IMU_BENCH_SLOW=y
CONFIG_I2C0_PIN_SDA=21
CONFIG_I2C0_PIN_SCL=22
CONFIG_MPU_PIN_INT=19
CONFIG_TRANSPORT_NATIVE_WIFI=n
CONFIG_TRANSPORT_NONE=y
CONFIG_ESPNOW_CONTROL=n
CONFIG_MOTORS_STARTUP_TEST=n
CONFIG_BUZZER_ON=n
